VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server/script-only — used by scripts/*.mjs (seed.js, backfill-*.mjs).
# NEVER prefix with VITE_ (that would inline it into the browser bundle).
# Same project as above; SUPABASE_URL is the same URL, just without the
# VITE_ prefix since these are plain Node scripts, not Vite client code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
